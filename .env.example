APP_ENV=development
APP_NAME=gift-trader-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://gift_trader:gift_trader@localhost:5432/gift_trader
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=604800
TELEGRAM_BOT_TOKEN=
# AI analyst. Server side key, never shipped to the browser.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_REQUESTS_PER_HOUR=30
AI_VERDICT_CACHE_SECONDS=600
# Active market parsers, comma separated: tonnel, mrkt, getgems, portals, fragment.
# Arbitrage needs at least two venues carrying the same gift.
MARKET_SOURCES=tonnel,getgems
CRAWL_MAX_PAGES=200
TONNEL_ENDPOINT=https://gifts2.tonnel.network/api/pageGifts
# Real sale history. Log in at market.tonnel.network, DevTools ->
# Application -> Local Storage -> web-initData, and paste the value here.
TONNEL_AUTH_DATA=
TONNEL_HISTORY_ENDPOINT=https://gifts2.tonnel.network/api/saleHistory
TRADE_SYNC_INTERVAL_SECONDS=900
TRADE_SYNC_ENABLED=true
# MRKT, the second venue for arbitrage. Add "mrkt" to MARKET_SOURCES once set.
# Either paste a bearer token straight from the app, or give init data and the
# server will exchange it for a token on each crawl.
# Telegram Web -> @mrkt -> DevTools -> Network -> the /auth response holds the token.
MRKT_TOKEN=
MRKT_INIT_DATA=
MRKT_BASE_URL=https://api.tgmrkt.io/api/v1
# Optional but recommended: raises TONAPI rate limits. Get one at https://tonconsole.com
TONAPI_TOKEN=
TONAPI_BASE_URL=https://tonapi.io
# Optional: comma separated TON gift collection addresses.
# Defaults to Plush Pepes + Durov's Caps. Copy more from getgems.io/collection/<address>
GETGEMS_COLLECTION_ADDRESSES=
# Only needed if you add "portals" to MARKET_SOURCES.
# Telegram Web -> @portals -> DevTools console -> window.Telegram.WebApp.initData
PORTALS_AUTH_DATA=
PORTALS_ENDPOINT=https://portals-market.com/api/nfts/search
SOURCE_TIMEOUT_SECONDS=20
SOURCE_RETRIES=2
SOURCE_BACKOFF_SECONDS=0.5
MARKET_SYNC_INTERVAL_SECONDS=300
MARKET_SYNC_ENABLED=true
PORTFOLIO_SYNC_INTERVAL_SECONDS=300
PORTFOLIO_SYNC_ENABLED=true
