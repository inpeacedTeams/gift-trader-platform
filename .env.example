APP_ENV=development
APP_NAME=gift-trader-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://gift_trader:gift_trader@localhost:5432/gift_trader
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=604800
